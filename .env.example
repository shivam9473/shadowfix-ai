# Copy to .env and fill only the keys you have. The demo pipeline runs without them.
# Never commit .env. Never put long-lived AWS write keys here.

SHADOWFIX_ENV=development
ADMIN_API_KEY=change-me
SUPERADMIN_EMAIL=admin@shadowfix.ai
SUPERADMIN_PASSWORD=

# Gemini — Flash routes, Pro writes patches. Either name works.
GEMINI_API_KEY=
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# Qdrant. Leave URL empty to use the on-disk client under backend/data/qdrant.
# QDRANT_MODE=memory is for tests. cloud uses URL + API key.
QDRANT_MODE=disk
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=shadowfix_ast

# E2B runs untrusted patches. There is no local Docker fallback.
E2B_API_KEY=

# GitHub PR publishing. This token is read only from the environment,
# never from the gh CLI login on the machine.
GITHUB_TOKEN=
GITHUB_REPOSITORY=
GITHUB_BASE_BRANCH=main

# AWS deploy role. Approve mints a 15-minute STS session for this role only.
SHADOWFIX_DEPLOY_ROLE_ARN=
SHADOWFIX_DEPLOY_BUCKET=

# Payment Gateways (Razorpay & PayPal)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PAYMENT_LINK=https://razorpay.me/@shivamkumar98
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox

# Optional signals
RESEND_WEBHOOK_SECRET=
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=shadowfix
TOXIPROXY_API=
SHOPKART_URL=
MEM0_API_KEY=
