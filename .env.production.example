# ==============================================================================
# ShadowFix AI - Production Environment Template
# Rename this file to '.env' on your production server.
# ==============================================================================

# ── General Server Settings ──
SHADOWFIX_ENV=production
ADMIN_API_KEY=replace-with-a-very-strong-64-character-random-hex-string
JWT_SECRET=replace-with-a-random-32-byte-hex-string
SUPERADMIN_EMAIL=admin@shadowfix.ai
SUPERADMIN_PASSWORD=replace-with-a-strong-admin-password

# ── PostgreSQL Database ──
POSTGRES_DB=shadowfix_prod
POSTGRES_USER=shadowfix
POSTGRES_PASSWORD=replace-with-strong-db-password
DATABASE_URL=postgresql://shadowfix:replace-with-strong-db-password@shadowfix-postgres:5432/shadowfix_prod

# ── Redis Cache, Session Fast-Path & Rate Limiting ──
REDIS_URL=redis://shadowfix-redis:6379/0

# ── Qdrant Vector Engine (AST Code Embeddings) ──
QDRANT_MODE=disk

# ── AI LLM Providers (Provide at least one) ──
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Untrusted Code Sandbox (E2B) ──
E2B_API_KEY=

# ── Payment Gateways (Razorpay & PayPal) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PAYMENT_LINK=https://razorpay.me/@shivamkumar98
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox

# ── Figma REST API Token (Optional, for private Figma files) ──
FIGMA_ACCESS_TOKEN=
